# /etc/mizan/mizan.env - environment for mizan.service.
# After editing:  systemctl restart mizan   (prewarm runs again, ~15-40 s)

# Bind to loopback only; Caddy is the only thing that reaches the app.
# Caddy forwards the PUBLIC Host header, so that hostname must be listed in
# MIZAN_ALLOWED_HOSTS or app.py's DNS-rebinding guard answers 403 BAD_HOST.
# provision.sh fills __DOMAIN__ in. Every other hostname is still refused.
MIZAN_HOST=127.0.0.1
MIZAN_ALLOWED_HOSTS=__DOMAIN__
MIZAN_PORT=8000

# Reviewer state lives outside the code directory so deploy/push.sh can never
# overwrite it.
MIZAN_REVIEW_DB=/var/lib/mizan/review.sqlite

# Seconds a check may wait for the engine (queue time included). The browser
# gives up on /api/check at 120 s (web/app.js), so stay below that and the
# user sees the server's explanation rather than a generic browser timeout.
MIZAN_CHECK_TIMEOUT=115

# CPU inference, models from the local cache only, never downloaded at
# request time.
MIZAN_DEVICE=cpu
HF_HOME=/opt/mizan/hf
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# EMERGENCY SWITCH - deterministic path only: no model, ~0.45 GB RAM,
# ~2 s per 1,000 words. Use it if the AI tier misbehaves (see docs/DEPLOY.md,
# "Fallback"), then: systemctl restart mizan
#MIZAN_SEMANTIC=0
